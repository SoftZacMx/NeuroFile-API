# ──────────────────────────────────────────────────────────────────────────
# Base de datos MySQL (Docker). Levanta solo MySQL con: docker compose up mysql -d
# Si el puerto 3306 está ocupado, en docker-compose.yml usa "3307:3306" y aquí cambia 3306 por 3307.
# En Docker (entre contenedores) el host es "mysql"; desde el host local usa "localhost" o "127.0.0.1".
# ──────────────────────────────────────────────────────────────────────────
DATABASE_URL=mysql://neurofile:neurofile@localhost:3306/neurofile

# ──────────────────────────────────────────────────────────────────────────
# Servidor / general
# ──────────────────────────────────────────────────────────────────────────
# Puerto del servidor (por defecto 3000)
# PORT=3000
# Entorno: development | production
# NODE_ENV=development

# Orígenes permitidos por CORS (opcional). En producción, URL del frontend. Varios: separados por coma.
# CORS_ORIGIN=https://neurofile-frontend.up.railway.app

# JWT Secret para tokens de login y recuperación de contraseña (cambia en producción)
JWT_SECRET=your_jwt_secret_here

# ──────────────────────────────────────────────────────────────────────────
# Email (AWS SES SMTP) — recuperación de contraseña
# Región: us-east-1 (Virginia), us-west-2 (Oregon), eu-west-1 (Irlanda), etc.
# Endpoint SMTP: https://docs.aws.amazon.com/ses/latest/dg/smtp-connect.html
# ──────────────────────────────────────────────────────────────────────────
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_SECURE=false
# Credenciales SMTP: AWS SES → SMTP settings → Create SMTP credentials
SMTP_USER=your_smtp_username_here
SMTP_PASS=your_smtp_password_here
# Debe ser un email o dominio verificado en SES (en sandbox, también el destinatario)
EMAIL_FROM="NeuroFile <noreply@yourmail.com>"

# URL del frontend (enlace en el correo de recuperación de contraseña)
# Debe coincidir con la URL donde corre Vite (por defecto http://localhost:5173)
FRONTEND_URL=http://localhost:5173

# Minutos de validez del enlace de recuperación (debe coincidir con el texto del correo)
RESET_TOKEN_EXPIRES_MINUTES=30

# ──────────────────────────────────────────────────────────────────────────
# AWS (credenciales y región para SDK/CLI; en prod usar credenciales/región reales)
# ──────────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# ──────────────────────────────────────────────────────────────────────────
# AWS S3 (Fase 1.2, 2.1). MinIO local: define S3_ENDPOINT; AWS real: déjalo sin definir.
# ──────────────────────────────────────────────────────────────────────────
S3_BUCKET_AUDIO=neurofile-conversations
# S3_ENDPOINT=http://localhost:9000
# MinIO (S3 local): credenciales del contenedor. En AWS real, el SDK usa AWS_ACCESS_KEY_ID/SECRET.
S3_ACCESS_KEY_ID=your_s3_access_key_id
S3_SECRET_ACCESS_KEY=your_s3_secret_access_key

# ──────────────────────────────────────────────────────────────────────────
# AWS SQS (Fase 1.3–1.4)
# Para API/workers desde el host: endpoint público (LocalStack: localhost:4566; prod: vacío).
# ──────────────────────────────────────────────────────────────────────────
# SQS_ENDPOINT=http://localhost:4566
# SQS_INIT_ENDPOINT: solo para sqs-init en Docker; por defecto http://localstack:4566
# SQS_INIT_ENDPOINT=http://localstack:4566

# Nombres de colas (con SQS_ENDPOINT se construye la URL: endpoint/000000000000/nombre en LocalStack)
SQS_QUEUE_AUDIO_FRAGMENTS=neurofile-audio-fragments
SQS_QUEUE_TRANSCRIBE_CONVERSATION=neurofile-transcribe-conversation
SQS_QUEUE_SUMMARIZE_MAP=neurofile-summarize-map

# URLs completas (prod). Si se setean, el código usa estas en lugar de construir desde endpoint + nombre.
SQS_QUEUE_URL_AUDIO_FRAGMENTS=https://sqs.us-east-1.amazonaws.com/000000000000/neurofile-audio-fragments
SQS_QUEUE_URL_TRANSCRIBE_CONVERSATION=https://sqs.us-east-1.amazonaws.com/000000000000/neurofile-transcribe-conversation
SQS_QUEUE_URL_SUMMARIZE_MAP=https://sqs.us-east-1.amazonaws.com/000000000000/neurofile-summarize-map

# DLQs (Dead Letter Queues). Si no se definen, se derivan agregando "-dlq" al nombre de la cola.
SQS_QUEUE_URL_AUDIO_FRAGMENTS_DLQ=https://sqs.us-east-1.amazonaws.com/000000000000/neurofile-audio-fragments-dlq
SQS_QUEUE_URL_TRANSCRIBE_CONVERSATION_DLQ=https://sqs.us-east-1.amazonaws.com/000000000000/neurofile-transcribe-conversation-dlq
SQS_QUEUE_URL_SUMMARIZE_MAP_DLQ=https://sqs.us-east-1.amazonaws.com/000000000000/neurofile-summarize-map-dlq

# ──────────────────────────────────────────────────────────────────────────
# OpenAI / Whisper y LLM (Fase 5–6)
# Para worker:transcribe con Whisper vía API (cuando WHISPER_PROVIDER=openai).
# Clave en https://platform.openai.com/api-keys
# ──────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key
# Modelo usado en la fase de resumen (summarize). Opcional.
# OPENAI_SUMMARIZE_MODEL=gpt-4o-mini

# ──────────────────────────────────────────────────────────────────────────
# Whisper (transcripción)
# WHISPER_PROVIDER=openai | local (por defecto openai)
#   openai → usa OPENAI_API_KEY
#   local  → usa el microservicio services/whisper-service (sin cuota OpenAI)
# ──────────────────────────────────────────────────────────────────────────
WHISPER_PROVIDER=openai
# URL del microservicio local. En Docker: http://whisper-service:8000
WHISPER_SERVICE_URL=http://localhost:8000
# Tamaño del modelo (solo microservicio): base, small, medium
WHISPER_MODEL_SIZE=medium
# Idioma de transcripción
WHISPER_LANGUAGE=es
# Tamaño máximo de archivo en bytes (opcional)
# WHISPER_MAX_FILE_SIZE_BYTES=26214400

# ──────────────────────────────────────────────────────────────────────────
# Verificar SMTP: npm run verify:smtp
# Frontend (.env): VITE_API_BASE_URL=http://localhost:3000/api
# Documentación: docs/PASSWORD_RESET.md
# ──────────────────────────────────────────────────────────────────────────
