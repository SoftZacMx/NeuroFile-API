# Base de datos MySQL (Docker). Levanta solo MySQL con: docker compose up mysql -d
# Si el puerto 3306 está ocupado, en docker-compose.yml usa "3307:3306" y en la URL abajo cambia 3306 por 3307.
DATABASE_URL=mysql://neurofile:neurofile@localhost:3306/neurofile

# Orígenes permitidos por CORS (opcional). En producción, URL del frontend. Varios: separados por coma.
# CORS_ORIGIN=https://neurofile-frontend.up.railway.app

# AWS SES SMTP Configuration
# Región: us-east-1 (Virginia), us-west-2 (Oregon), eu-west-1 (Irlanda), etc.
# Encuentra tu endpoint SMTP en: https://docs.aws.amazon.com/ses/latest/dg/smtp-connect.html
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_SECURE=false
# Credenciales SMTP: AWS SES → SMTP settings → Create SMTP credentials
SMTP_USER=your_smtp_username_here
SMTP_PASS=your_smtp_password_here
# Debe ser un email o dominio verificado en SES (en sandbox, también el destinatario)
EMAIL_FROM="NeuroFile <noreply@yourmail.com>"

# URL del frontend (enlace en el correo de recuperación de contraseña)
# Debe coincidir con la URL donde corre Vite (por defecto http://localhost:5173)
FRONTEND_URL=http://localhost:5173

# JWT Secret para tokens de login y recuperación de contraseña
JWT_SECRET=your_jwt_secret_here

# Minutos de validez del enlace de recuperación (debe coincidir con el texto del correo)
RESET_TOKEN_EXPIRES_MINUTES=30

# Verificar SMTP: npm run verify:smtp
# Frontend (.env): VITE_API_BASE_URL=http://localhost:3000/api
# Documentación: docs/PASSWORD_RESET.md
