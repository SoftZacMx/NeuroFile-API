meta {
  name: reset-password
  type: http
  seq: 4
}

post {
  url: {{base_url}}/auth/reset-password
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "token": "{{reset_token}}",
    "password": "{{new_password}}"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  1. Ejecuta forgot-password y abre el enlace del correo.
  2. Copia el valor de ?token=... al environment reset_token.
  3. Ajusta new_password si hace falta y envía esta petición.
}
