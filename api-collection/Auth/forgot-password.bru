meta {
  name: forgot-password
  type: http
  seq: 3
}

post {
  url: {{base_url}}/auth/forgot-password
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{test_email}}"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Solicita enlace de recuperación. No requiere JWT.
  En SES sandbox, test_email debe estar verificado en AWS y existir en la BD.
  Tras recibir el correo, copia el token del enlace a reset_token y usa reset-password.
}
