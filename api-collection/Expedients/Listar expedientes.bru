meta {
  name: Listar expedientes
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/expedients?patientId=1
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

settings {
  encodeUrl: true
}

docs {
  Lista expedientes. Opcional: `?patientId=1` filtra por paciente.
  Sin query param devuelve todos los expedientes (pantalla global).
}
