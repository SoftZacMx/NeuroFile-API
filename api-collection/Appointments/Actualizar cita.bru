meta {
  name: Actualizar cita
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/appointments/:appointment_id
  body: json
  auth: bearer
}

params:path {
  appointment_id: 3
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "date": "{{currentDate}}",
    "status": true,
    "attended": true
  }
}

settings {
  encodeUrl: true
}

docs {
